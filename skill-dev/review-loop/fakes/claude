#!/usr/bin/env python3
# テスト用の偽 claude。振る舞いは環境変数で切り替える。
#   FAKE_DIR                 呼び出しの記録(calls.jsonl)を置く場所
#   FAKE_SKILLS              init で返すスキル(カンマ区切り。既定は観点スキル全部)
#   FAKE_PREFLIGHT_DELAY     init を返すまでの秒数
#   FAKE_PREFLIGHT           事前確認の振る舞い。ok(既定。Bash で pwd を実行して答える) / bash_error(Bash が失敗する)
#                            / fail_then_deny(Bash が失敗し、続く呼び出しが拒否される) / deny(Bash が拒否される)
#                            / nobash(Bash を呼ばずに答える) / noresult(Bash の結果が届かないまま答える)
#                            / api_error(Bash の前に応答が失敗する) / max_turns(Bash は成功し、ターン数の上限で終わる)
#                            / eof(init のあと result を出さずに終わる) / hang(init のあと何も返さない)
#                            / dirty(作業ツリーを変える)
#   FAKE_REVIEW_<観点>       ok(既定) / deny / fail / empty(結果が空) / dirty / hang / slow / bg(孫を残して終わる)
#                            / remote(PR のブランチにだけ別のコミットを push する)
#                            / switch(作業ツリーはクリーンのまま、別のブランチに切り替える)
#                            <観点> は英数字以外を _ にしたもの(例: FAKE_REVIEW_code_review)
#   FAKE_JUDGE               ok(既定) / noheading(決めた見出しがない) / empty(結果が空)
#                            / fenced(前置きとコードフェンスで包み、見出しに文字を足す)
import json
import os
import re
import stat
import sys
import time

args = sys.argv[1:]
fake_dir = os.environ["FAKE_DIR"]


def record(kind, **extra):
    with open(os.path.join(fake_dir, "calls.jsonl"), "a") as f:
        f.write(json.dumps({"kind": kind, "pid": os.getpid(), "cwd": os.getcwd(), "args": args,
                            "env_job_dir": "CLAUDE_JOB_DIR" in os.environ,
                            "env_session_id": "CLAUDE_CODE_SESSION_ID" in os.environ,
                            "guard": os.environ.get("REVIEW_LOOP_ACTIVE"), **extra}) + "\n")


def result(text, **extra):
    d = {"type": "result", "subtype": "success", "is_error": False, "result": text,
         "permission_denials": [], "total_cost_usd": 0.5,  # 本体は読まないが、本物の出力に合わせて残す
         # usage はサブエージェントの分を含まないので、modelUsage と食い違わせておく
         "usage": {"input_tokens": 1, "output_tokens": 1},
         "modelUsage": {"m": {"inputTokens": 500, "cacheCreationInputTokens": 1000, "cacheReadInputTokens": 2000,
                              "outputTokens": 300}}}
    d.update(extra)
    print(json.dumps(d, ensure_ascii=False), flush=True)


if "stream-json" in args:
    record("preflight")
    skills = os.environ.get("FAKE_SKILLS", "code-review,mattpocock-skills:code-review").split(",")
    mode = os.environ.get("FAKE_PREFLIGHT", "ok")
    if mode not in ("ok", "bash_error", "fail_then_deny", "deny", "nobash", "noresult", "api_error", "max_turns",
                    "eof", "hang", "dirty"):
        sys.exit(f"未知の FAKE_PREFLIGHT: {mode}")

    def emit(d):
        print(json.dumps(d, ensure_ascii=False), flush=True)

    def bash_result(is_error, text):
        emit({"type": "user", "message": {"content": [{"type": "tool_result", "tool_use_id": "t1", "is_error": is_error,
              "content": [{"type": "text", "text": text}]}]}})

    emit({"type": "system", "subtype": "hook_started"})
    time.sleep(float(os.environ.get("FAKE_PREFLIGHT_DELAY", "0")))
    emit({"type": "system", "subtype": "init", "cwd": os.getcwd(), "skills": skills,
          "slash_commands": skills + ["security-review", "clear"]})
    if mode == "hang":
        time.sleep(60)  # 制限時間で止められるはず
        record("preflight-not-killed")
        sys.exit(0)
    if mode == "eof":  # result を出さずに終わる
        sys.exit(1)
    if mode == "api_error":  # 認証の失敗など。Bash を呼ぶ前に応答が失敗する
        result("Not logged in · Please run /login", subtype="success", is_error=True)
        sys.exit(1)
    if mode != "nobash":
        emit({"type": "assistant", "message": {"content": [
            {"type": "tool_use", "id": "t1", "name": "Bash", "input": {"command": "pwd"}}]}})
    denial = [{"tool_name": "Bash", "tool_use_id": "t1", "tool_input": {"command": "pwd"}}]
    if mode == "deny":
        bash_result(True, "denied")  # 本物も、拒否された呼び出しには is_error の tool_result を返す
        result("拒否された", permission_denials=denial)
    elif mode in ("bash_error", "fail_then_deny"):
        bash_result(True, "sandbox-exec: sandbox_apply: Operation not permitted")
        # fail_then_deny: 子が sandbox を外して再試行し、それが拒否される
        result("失敗した", permission_denials=denial if mode == "fail_then_deny" else [])
    elif mode == "max_turns":
        bash_result(False, os.getcwd())
        result("", subtype="error_max_turns", is_error=True)
    elif mode == "dirty":  # 事前確認の子(やそのフック)が作業ツリーを変える
        open("preflight-stray.txt", "w").write("x")
        bash_result(False, os.getcwd())
        result(os.getcwd())
    elif mode == "ok":
        bash_result(False, os.getcwd())
        result(os.getcwd())
    else:  # nobash(Bash を呼ばずに答える)と noresult(Bash の結果が届かないまま答える)
        result(os.getcwd())
    sys.exit(0)

if stat.S_ISREG(os.fstat(0).st_mode):  # 判定役(標準入力にレビューの出力のファイルを受け取るのは判定役だけ)
    stdin = sys.stdin.read()
    record("judge", stdin=stdin)
    mode = os.environ.get("FAKE_JUDGE", "ok")
    if mode == "noheading":
        result("done")
    elif mode == "empty":
        result("")
    elif mode == "fenced":
        result("以下が判定です。\n\n```markdown\n## 指摘(1件)\n\n### F1: s\n\n```sh\nx\n```\n\n## 競合\n\nなし\n```\n")
    elif mode == "codeend":  # 前置きはなく、最後の項目が正当なコードブロックで終わる
        result("## 指摘\n\nなし\n\n## 競合\n\n### C1: t\n```sh\nx\n```\n")
    elif mode == "conflictfirst":
        result("## 競合\n\nなし\n\n## 指摘\n\nなし\n")
    else:
        result("## 指摘\n\n### F1: s\n- 観点: code-review\n- 場所: a.txt:1\n- 影響: 中。r\n\n## 競合\n\nなし\n")
    sys.exit(0)

name = args[-1].split()[0].lstrip("/")
record("review", name=name)
mode = os.environ.get("FAKE_REVIEW_" + re.sub(r"[^A-Za-z0-9]", "_", name), "ok")
if mode == "deny":
    result("読めなかった", permission_denials=[{"tool_name": "Bash", "tool_use_id": "x",
                                               "tool_input": {"command": "gh pr diff 7"}}])
elif mode == "fail":
    print("boom", file=sys.stderr)
    sys.exit(1)
elif mode == "empty":
    result("")
elif mode == "dirty":
    open("stray.txt", "w").write("x")
    result(f"{name}: 指摘なし")
elif mode == "hang":
    time.sleep(120)
    record("review-not-killed", name=name)
elif mode == "remote":  # 作業ツリーには触れず、PR のブランチにだけ別のコミットを push する
    import subprocess
    sha = subprocess.run(["git", "commit-tree", "HEAD^{tree}", "-p", "HEAD", "-m", "remote"],
                         capture_output=True, text=True).stdout.strip()
    subprocess.run(["git", "push", "-q", "origin", f"{sha}:refs/heads/feature"], capture_output=True)
    result(f"{name}: 指摘なし")
elif mode == "switch":  # 作業ツリーはクリーンのまま、別のブランチに切り替える
    import subprocess
    subprocess.run(["git", "switch", "-q", "-c", "other"], capture_output=True)
    result(f"{name}: 指摘なし")
elif mode == "bg":
    import subprocess
    g = subprocess.Popen(["sleep", "120"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    record("grandchild", name=name, grandchild=g.pid)
    result(f"{name}: 指摘なし")
elif mode == "slow":
    time.sleep(3)
    result(f"{name}: 指摘1件")
else:
    result(f"{name}: 指摘1件")
