#!/usr/bin/env python3
# テスト用の偽 claude。振る舞いは環境変数で切り替える。
#   FAKE_DIR                 呼び出しの記録(calls.jsonl)を置く場所
#   FAKE_SKILLS              init で返すスキル(カンマ区切り。既定は観点スキル全部)
#   FAKE_PREFLIGHT_DELAY     init を返すまでの秒数
#   FAKE_REVIEW_<観点>       ok(既定) / deny / denylive(拒否のイベントを出して、終わらずに続ける) / fail / empty(結果が空) / dirty / hang / slow / bg(孫を残して終わる)
#                            / denyconfig(設定のルールでの拒否のイベントを出したあと、正常に終わる)
#                            / denyclassifier(source は config だが、分類器による拒否のイベントを出したあと、正常に終わる)
#                            / denynoid(denyconfig と同じだが、イベントに tool_use_id がない)
#                            / denyconfighang(設定のルールでの拒否のイベントを出したあと、終わらずに続ける)
#                            / denyrepeat(tool_use_id のない同じ拒否を、2つの result の行に載せる)
#                            / failslow(1秒待ってから異常終了する)
#                            / multierror(result の行を複数出し、途中の行はエラー)
#                            / multiempty・multishort(result の行を複数出し、本文は途中の行に入れる。最後の行は空 / 短い文)
#                            / multiallempty(result の行を複数出し、どれも空)
#                            / remote(PR のブランチにだけ別のコミットを push する)
#                            / switch(作業ツリーはクリーンのまま、別のブランチに切り替える)
#                            <観点> は英数字以外を _ にしたもの(例: FAKE_REVIEW_code_review)
#   FAKE_JUDGE               ok(既定) / noheading(決めた見出しがない) / empty(結果が空)
#                            / fenced(前置きとコードフェンスで包み、見出しに文字を足す)
#                            / multi(result の行を複数出し、判定は途中の行に入れる。最後の行は空)
#                            / multishort(判定のあとに、短い文だけの result の行を出す)
#                            / partiallater(判定のあとに、見出しを一部だけ持つ訂正の result の行を出す)
#                            / redo(前置きとフェンスで包んだ下書きの判定を出したあと、直した判定を出す)
#                            / denyconfig(設定のルールでの拒否のイベントを出したあと、正常に終わる)
# 出力は本物と同じく stream-json(1行1イベント)。事前確認以外は init の行から始める
import json
import os
import re
import stat
import sys
import time

args = sys.argv[1:]
fake_dir = os.environ["FAKE_DIR"]


def record(kind, **extra):
    with open(os.path.join(fake_dir, "calls.jsonl"), "a") as f:
        f.write(json.dumps({"kind": kind, "pid": os.getpid(), "cwd": os.getcwd(), "args": args,
                            "env_job_dir": "CLAUDE_JOB_DIR" in os.environ,
                            "env_session_id": "CLAUDE_CODE_SESSION_ID" in os.environ,
                            "guard": os.environ.get("REVIEW_LOOP_ACTIVE"), **extra}) + "\n")


def emit(d):
    print(json.dumps(d, ensure_ascii=False), flush=True)


def deny(source=None, reason_type="subcommandResults", tool_use_id="x"):
    """拒否のイベントを出す。拒否されたツールの入力はイベントにないので、tool_use の行から引けることを
    確かめられるよう、イベントに入力を含めない。"""
    emit({"type": "assistant", "message": {"content": [
        {"type": "tool_use", "id": "x", "name": "Bash", "input": {"command": "gh pr diff 7; grep -n KEY .env"}}]}})
    d = {"type": "system", "subtype": "permission_denied", "tool_name": "Bash", "message": "Permission denied."}
    if tool_use_id:
        d["tool_use_id"] = tool_use_id
    if source:
        d.update(source=source, reason_type=reason_type)
    emit(d)


def result(text, **extra):
    d = {"type": "result", "subtype": "success", "is_error": False, "result": text,
         "permission_denials": [], "total_cost_usd": 0.5,  # 本体は読まないが、本物の出力に合わせて残す
         # usage はサブエージェントの分を含まないので、modelUsage と食い違わせておく
         "usage": {"input_tokens": 1, "output_tokens": 1},
         "modelUsage": {"m": {"inputTokens": 500, "cacheCreationInputTokens": 1000, "cacheReadInputTokens": 2000,
                              "outputTokens": 300}}}
    d.update(extra)
    emit(d)


def multi(*texts):
    """サブエージェントをバックグラウンドで動かしたときのように、ターンごとに result の行を出す。
    サブエージェント自身の result の行(parent_tool_use_id 付き)も混ぜ、本体が拾わないことを確かめる。"""
    emit({"type": "result", "subtype": "success", "is_error": False, "result": "サブエージェントの結果",
          "parent_tool_use_id": "toolu_sub"})
    for t in texts:
        result(t)


if args[-1] == "ok":  # 事前確認(レビュー役も stream-json を使うので、プロンプトで見分ける)
    record("preflight")
    skills = os.environ.get("FAKE_SKILLS", "code-review,mattpocock-skills:code-review").split(",")
    print(json.dumps({"type": "system", "subtype": "hook_started"}), flush=True)
    time.sleep(float(os.environ.get("FAKE_PREFLIGHT_DELAY", "0")))
    print(json.dumps({"type": "system", "subtype": "init", "cwd": os.getcwd(), "skills": skills,
                      "slash_commands": skills + ["security-review", "clear"]}), flush=True)
    time.sleep(60)  # 止められるはず
    record("preflight-not-killed")
    sys.exit(0)

emit({"type": "system", "subtype": "init", "cwd": os.getcwd()})

if stat.S_ISREG(os.fstat(0).st_mode):  # 判定役(標準入力にレビューの出力のファイルを受け取るのは判定役だけ)
    stdin = sys.stdin.read()
    record("judge", stdin=stdin)
    mode = os.environ.get("FAKE_JUDGE", "ok")
    verdict = "## 指摘\n\n### F1: s\n- 観点: code-review\n- 場所: a.txt:1\n- 影響: 中。r\n\n## 競合\n\nなし\n"
    if mode == "multi":
        multi("レビューを突き合わせています。", verdict, "")
    elif mode == "multishort":
        multi(verdict, "前のメッセージの内容から変わりません")
    elif mode == "partiallater":
        multi(verdict, "## 指摘\n\n補足: F1 の行番号は 2")
    elif mode == "redo":
        multi("以下が判定です。\n\n```markdown\n## 指摘\n\n### F1: 下書き\n\n## 競合\n\nなし\n```", verdict)
    elif mode == "denyconfig":
        deny("config")
        result(verdict, permission_denials=[{"tool_name": "Bash", "tool_use_id": "x", "tool_input": {}}])
    elif mode == "noheading":
        result("done")
    elif mode == "empty":
        result("")
    elif mode == "fenced":
        result("以下が判定です。\n\n```markdown\n## 指摘(1件)\n\n### F1: s\n\n```sh\nx\n```\n\n## 競合\n\nなし\n```\n")
    elif mode == "codeend":  # 前置きはなく、最後の項目が正当なコードブロックで終わる
        result("## 指摘\n\nなし\n\n## 競合\n\n### C1: t\n```sh\nx\n```\n")
    elif mode == "conflictfirst":
        result("## 競合\n\nなし\n\n## 指摘\n\nなし\n")
    else:
        result(verdict)
    sys.exit(0)

name = args[-1].split()[0].lstrip("/")
record("review", name=name)
mode = os.environ.get("FAKE_REVIEW_" + re.sub(r"[^A-Za-z0-9]", "_", name), "ok")
if mode == "deny":
    result("読めなかった", permission_denials=[{"tool_name": "Bash", "tool_use_id": "x",
                                               "tool_input": {"command": "gh pr diff 7"}}])
elif mode == "fail":
    print("boom", file=sys.stderr)
    sys.exit(1)
elif mode == "empty":
    result("")
elif mode == "dirty":
    open("stray.txt", "w").write("x")
    result(f"{name}: 指摘なし")
elif mode == "denylive":  # 拒否されても終わらずに作業を続ける(本物の claude と同じく、拒否のイベントを出す。source はない)
    deny()
    time.sleep(120)
    record("review-not-killed", name=name)
elif mode == "denyconfig":  # 設定のルールで拒否されたあと、該当部分を外して続け、正常に終わる
    deny("config")
    result(f"{name}: 指摘1件", permission_denials=[{"tool_name": "Bash", "tool_use_id": "x",
                                                   "tool_input": {"command": "gh pr diff 7; grep -n KEY .env"}}])
elif mode in ("denyclassifier", "denynoid"):
    if mode == "denyclassifier":
        deny("config", reason_type="classifier")
    else:
        deny("config", tool_use_id=None)
    result(f"{name}: 指摘1件", permission_denials=[{"tool_name": "Bash", "tool_input": {"command": "gh pr diff 7"},
                                                   **({"tool_use_id": "x"} if mode == "denyclassifier" else {})}])
elif mode == "denyrepeat":
    same = [{"tool_name": "Bash", "tool_input": {"command": "gh pr diff 7"}}]
    result("途中", permission_denials=same)
    result(f"{name}: 指摘1件", permission_denials=same)
elif mode == "denyconfighang":
    deny("config")
    time.sleep(120)
    record("review-not-killed", name=name)
elif mode == "failslow":
    time.sleep(1)
    print("boom", file=sys.stderr)
    sys.exit(1)
elif mode == "multierror":
    result("API Error: overloaded", is_error=True)
    result(f"{name}: 本文")
elif mode == "multiempty":
    multi("2つのレビューをバックグラウンドで実行しています", "Standards のレビューは終わりました",
          f"{name}: 本文", "")
elif mode == "multishort":
    multi("2つのレビューをバックグラウンドで実行しています", f"{name}: 本文", "前のメッセージの内容から変わりません")
elif mode == "multiallempty":
    multi("", "")
elif mode == "hang":
    time.sleep(120)
    record("review-not-killed", name=name)
elif mode == "remote":  # 作業ツリーには触れず、PR のブランチにだけ別のコミットを push する
    import subprocess
    sha = subprocess.run(["git", "commit-tree", "HEAD^{tree}", "-p", "HEAD", "-m", "remote"],
                         capture_output=True, text=True).stdout.strip()
    subprocess.run(["git", "push", "-q", "origin", f"{sha}:refs/heads/feature"], capture_output=True)
    result(f"{name}: 指摘なし")
elif mode == "switch":  # 作業ツリーはクリーンのまま、別のブランチに切り替える
    import subprocess
    subprocess.run(["git", "switch", "-q", "-c", "other"], capture_output=True)
    result(f"{name}: 指摘なし")
elif mode == "bg":
    import subprocess
    g = subprocess.Popen(["sleep", "120"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    record("grandchild", name=name, grandchild=g.pid)
    result(f"{name}: 指摘なし")
elif mode == "slow":
    time.sleep(3)
    result(f"{name}: 指摘1件")
else:
    result(f"{name}: 指摘1件")
