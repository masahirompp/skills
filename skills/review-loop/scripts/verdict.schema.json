{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "review-loop verdict",
  "type": "object",
  "additionalProperties": false,
  "required": ["findings", "conflicts", "recommendation"],
  "properties": {
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "perspectives", "file", "line", "summary", "rationale", "behavior_change", "category", "conflict"],
        "properties": {
          "id": { "type": "string", "description": "F1, F2, ... の連番" },
          "perspectives": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "description": "この指摘を挙げた観点スキルの名前"
          },
          "file": { "type": "string", "description": "対象ファイルのリポジトリ相対パス。特定できなければ空文字" },
          "line": { "type": "integer", "minimum": 0, "description": "対象の行。特定できなければ 0" },
          "summary": { "type": "string", "description": "指摘の要約" },
          "rationale": { "type": "string", "description": "根拠。コードで確かめた結果も含める" },
          "behavior_change": { "type": "boolean", "description": "この指摘に従って修正したときに挙動が変わるか" },
          "category": { "type": "string", "enum": ["defect", "test_gap", "naming_or_comment", "style", "other"] },
          "conflict": {
            "type": ["string", "null"],
            "description": "裁定の結果 fix となった競合から来た指摘なら、その競合の id(C1 など)。それ以外は null"
          }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "file", "line", "findings", "tension", "ruling"],
        "properties": {
          "id": { "type": "string", "description": "C1, C2, ... の連番" },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 0 },
          "findings": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["perspective", "summary"],
              "properties": {
                "perspective": { "type": "string" },
                "summary": { "type": "string" }
              }
            }
          },
          "tension": { "type": "string", "description": "何と何がトレードオフになっているか" },
          "ruling": {
            "type": "object",
            "additionalProperties": false,
            "required": ["adopt", "rationale", "action"],
            "properties": {
              "adopt": { "type": "string", "description": "採用する観点" },
              "rationale": { "type": "string" },
              "action": { "type": "string", "enum": ["fix", "no_change"] }
            }
          }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["continue", "reason"],
      "properties": {
        "continue": { "type": "boolean", "description": "挙動が変わる修正を要する指摘が残っていれば true" },
        "reason": { "type": "string" }
      }
    }
  }
}
